# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit real secrets.

APP_ENV=development

# Local development uses SQLite. Docker and the deployed app use PostgreSQL, e.g.
# postgresql+psycopg://library:library@db:5432/library (postgresql://... works too).
# docker-compose.yml sets its own DATABASE_URL.
DATABASE_URL=sqlite:///./library.db

# Secret used to sign login tokens. Use a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-chars
JWT_EXPIRE_MINUTES=60

# First admin account, created at startup if it does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Used by the container (python -m scripts.start): seed the books on start, sample (20)
# or full (10,000). Leave empty to seed nothing.
SEED_BOOKS=

# Shown in the X-App-Version header of GET /health. Render sets RENDER_GIT_COMMIT instead.
APP_VERSION=
