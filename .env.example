# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit real secrets.

APP_ENV=development

# Local development uses SQLite. Docker and the deployed app use PostgreSQL, e.g.
# postgresql+psycopg://library:library@db:5432/library
DATABASE_URL=sqlite:///./library.db

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# First admin account, created at startup if it does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
